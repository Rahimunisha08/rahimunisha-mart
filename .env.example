# Application Environment Configuration
APP_NAME=RahimunishaMart
APP_PORT=8080
APP_ENV=development

# Database Configuration (H2 persistent file mode)
DB_DRIVER=org.h2.Driver
DB_URL=jdbc:h2:file:./data/rahimunishamart;DB_CLOSE_DELAY=-1;AUTO_SERVER=TRUE
DB_USERNAME=sa
DB_PASSWORD=

# HikariCP Pool Settings
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_TIMEOUT=30000

# Session Configuration
SESSION_TIMEOUT_MINUTES=30

# AI Chatbot Configuration
# Provider: 'mock' (offline rule-based domain FAQ) or 'gemini' (Google Gemini 1.5 Flash API)
AI_CHATBOT_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_here
